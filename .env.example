# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
PLATFORM_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3001,http://localhost:3002
SWAGGER_ENABLED=true

# ─── Database (Neon PostgreSQL) ───────────────────────────────────────────────
# Use the pooler endpoint for better connection management
DATABASE_URL=postgresql://user:password@host.pooler.neon.tech:6432/dbname?sslmode=require

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
JWT_ACCESS_SECRET=replace-with-at-least-32-char-random-secret
JWT_REFRESH_SECRET=replace-with-different-32-char-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Internal admin plane (/v1/platform). MUST be a different secret from the two
# above — it is what stops a tenant-token compromise from minting an admin token.
# Leave unset locally to disable the platform plane entirely; required in production.
JWT_PLATFORM_SECRET=replace-with-a-third-distinct-32-char-secret
JWT_PLATFORM_ACCESS_EXPIRY=15m
JWT_PLATFORM_REFRESH_EXPIRY=8h

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ─── Cloudflare R2 ────────────────────────────────────────────────────────────
R2_ACCOUNT_ID=your-account-id
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key
R2_BUCKET_NAME=bpos-files
R2_PUBLIC_URL=https://files.yourdomain.com
# Private files when PRIVATE_STORAGE_PROVIDER=r2. No public access / custom domain.
R2_PRIVATE_BUCKET_NAME=bpos-private

# ─── Private file storage ─────────────────────────────────────────────────────
# r2 (default) keeps everything on Cloudflare; neon uses Neon object storage below.
PRIVATE_STORAGE_PROVIDER=r2

# ─── Neon object storage (S3-compatible, private files) ───────────────────────
# Only used when PRIVATE_STORAGE_PROVIDER=neon. Values from the Neon console → Storage.
AWS_ENDPOINT_URL_S3=https://your-branch-storage.c-4.us-east-2.aws.neon.tech
AWS_ACCESS_KEY_ID=nak_live_xxx
AWS_SECRET_ACCESS_KEY=nsk_live_xxx
AWS_REGION=us-east-2
NEON_STORAGE_BUCKET=assets

# ─── Uploads ──────────────────────────────────────────────────────────────────
# Raw multipart upload cap enforced before sharp compression runs
MAX_UPLOAD_SIZE_BYTES=10485760

# ─── Paystack ─────────────────────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_live_xxx
PAYSTACK_PUBLIC_KEY=pk_live_xxx

# ─── Termii SMS ───────────────────────────────────────────────────────────────
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=BPOS

# ─── WhatsApp Business API (Phase 2) ─────────────────────────────────────────
WHATSAPP_VERIFY_TOKEN=your-webhook-verify-token
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id

# ─── Alerting ─────────────────────────────────────────────────────────────────
# Optional — when set, server errors (5xx) are posted to this Slack channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXX

# ─── Email (Resend) ───────────────────────────────────────────────────────────
# Optional — invoice PDFs are generated regardless; email delivery is skipped
# when RESEND_API_KEY is not set.
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Must be a verified sender domain in your Resend account
EMAIL_FROM=invoices@yourdomain.com
